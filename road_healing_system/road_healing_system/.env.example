# Copy this file to .env and adjust. Real environment variables take precedence.

# Address and port of the local web server. Keep 127.0.0.1 to allow only this computer.
APP_HOST=127.0.0.1
APP_PORT=5000

# Never enable debug mode on a shared network: it allows code execution from the browser.
APP_DEBUG=false

# Upload limit for all files of one request together, in megabytes.
MAX_UPLOAD_MB=25

# Where uploads, stage images, reports and the processing history are stored.
# Relative paths are resolved from the project folder.
STORAGE_DIR=storage

# How many processed jobs to keep; older job folders are deleted automatically.
KEEP_JOBS=50
